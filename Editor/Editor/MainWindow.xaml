<?xml version="1.0" encoding="utf-8"?>

<Window x:Class="Editor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Editor" 
	xmlns:views="clr-namespace:Editor.Views"
	mc:Ignorable="d"
    Title="MainWindow" Height="450" Width="800"
	WindowState="Maximized"	
	>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="auto" />
			<ColumnDefinition Width="2*" />

			<ColumnDefinition Width="auto" />

			<ColumnDefinition Width="300" />
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0" Background="#fff" Width="60px">
			<ItemsControl ItemsSource="{Binding Tabs}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Button 
							Content="{Binding Header}"
							Command="{Binding DataContext.SetSelectedTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
							CommandParameter="{Binding}"
							Height="60px"							
							>
							<Button.Style>
								<Style TargetType="Button">
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="BorderBrush" Value="Transparent" />
									<Setter Property="BorderThickness" Value="0" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsSelected}" Value="True">
											<Setter Property="Background" Value="#ddd" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
						</Button>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</Border>

		<TabControl
			Grid.Column="1"
			ItemsSource="{Binding Tabs}"
			SelectedItem="{Binding SelectedTab}"
			BorderThickness="0"
			>

			<TabControl.ItemContainerStyle>
				<Style TargetType="TabItem">
					<Setter Property="Visibility" Value="Collapsed" />
				</Style>
			</TabControl.ItemContainerStyle>

			<TabControl.ContentTemplate>
				<DataTemplate>
					<ContentControl Content="{Binding}">
						<ContentControl.Style>
							<Style TargetType="ContentControl">
								<Style.Triggers>

									<DataTrigger Binding="{Binding Header}" Value="Galería">
										<Setter Property="ContentTemplate">
											<Setter.Value>
												<DataTemplate>
													<views:GalleryView />
												</DataTemplate>
											</Setter.Value>
										</Setter>
									</DataTrigger>

									<DataTrigger Binding="{Binding Header}" Value="Crear">
										<Setter Property="ContentTemplate">
											<Setter.Value>
												<DataTemplate>
													<views:CreateView />
												</DataTemplate>
											</Setter.Value>
										</Setter>
									</DataTrigger>

									<DataTrigger Binding="{Binding Header}" Value="Editar">
										<Setter Property="ContentTemplate">
											<Setter.Value>
												<DataTemplate>
													<views:EditView />
												</DataTemplate>
											</Setter.Value>
										</Setter>
									</DataTrigger>

									<DataTrigger Binding="{Binding Header}" Value="Ordenar">
										<Setter Property="ContentTemplate">
											<Setter.Value>
												<DataTemplate>
													<views:SortView />
												</DataTemplate>
											</Setter.Value>
										</Setter>
									</DataTrigger>

								</Style.Triggers>
							</Style>
						</ContentControl.Style>
					</ContentControl>
				</DataTemplate>
			</TabControl.ContentTemplate>
		</TabControl>

		<GridSplitter 
			Grid.Column="2" 
            Width="2" 
            HorizontalAlignment="Stretch" 
            Background="#eee"
            ShowsPreview="True"
			/>

		<views:ApplicationEventsView Grid.Column="3" />

	</Grid>
</Window>